# Copy to .env and fill in. NEVER commit .env.

# Database
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=impilohealth_db
MYSQL_USER=impilo
MYSQL_PASSWORD=change_me
DB_URL=jdbc:mysql://localhost:3306/impilohealth_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION_MS=86400000

# AI provider: pangu (Huawei, production) | gemini (dev fallback) | mock (no credentials needed)
AI_PROVIDER=mock

# Huawei Pangu (ModelArts Studio) - copy endpoint + key from your Huawei Cloud console
PANGU_ENDPOINT=
PANGU_API_KEY=
PANGU_MODEL=pangu
PANGU_AUTH_HEADER=Authorization
PANGU_AUTH_PREFIX=Bearer 

# Gemini (dev fallback only)
GEMINI_API_KEY=

# Huawei Cloud (production only)
HUAWEI_CLOUD_AK=
HUAWEI_CLOUD_SK=
HUAWEI_CLOUD_REGION=af-south-1

# Frontend
API_BASE_URL=http://localhost:8080/api
